{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "target": "ES2022",
    "lib": ["ES2022"],
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["vite.cv.config.ts", "astro.config.mjs"]
}
