{
  "name": "website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "dev:cv": "vite --config vite.cv.config.ts --host 127.0.0.1 --port 5174",
    "build": "npm run build:workshop && npm run build:cv && npm run check:sites",
    "build:workshop": "astro build",
    "build:cv": "vite build --config vite.cv.config.ts",
    "check:sites": "node tools/check-sites.mjs",
    "preview": "astro preview",
    "preview:cv": "vite preview --config vite.cv.config.ts --host 127.0.0.1 --port 5174",
    "check": "astro check && svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.node.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "media:label": "node tools/media-labeler/server.mjs",
    "media:edit": "node tools/media-labeler/server.mjs",
    "media:import": ".media-tools\\Scripts\\python.exe docs\\import-labeled-media.py"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/three": "^0.183.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte-check": "^4.7.8",
    "tslib": "^2.9.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@astrojs/svelte": "9.1.2",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/recursive": "^5.3.0",
    "@fontsource-variable/sora": "^5.3.0",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@google/model-viewer": "^4.4.0",
    "astro": "7.4.4",
    "svelte": "^5.57.3",
    "three": "^0.183.2"
  },
  "engines": {
    "node": ">=22.22.0"
  }
}
