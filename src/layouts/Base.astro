---
import '../app.css';
import soraFont from '@fontsource-variable/sora/files/sora-latin-wght-normal.woff2?url';
import plexFont from '@fontsource-variable/ibm-plex-sans/files/ibm-plex-sans-latin-wght-normal.woff2?url';

type Props = {
  title: string;
  description: string;
  image: string;
  imageAlt: string;
  type?: 'website' | 'article';
  noindex?: boolean;
};

const {
  title,
  description,
  image,
  imageAlt,
  type = 'website',
  noindex = false
} = Astro.props;
const path = Astro.url.pathname.replace(/(?:index)?\.html$/, '');
const canonical = new URL(path, Astro.site);
const imageUrl = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? (
      <meta name="robots" content="noindex" />
    ) : (
      <link rel="canonical" href={canonical} />
    )}

    <link
      rel="preload"
      href={soraFont}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={plexFont}
      as="font"
      type="font/woff2"
      crossorigin
    />

    <link rel="icon" type="image/png" href="/favicon-32x32.png" sizes="32x32" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap.xml" />
    <meta name="apple-mobile-web-app-title" content="James R" />
    <meta name="theme-color" content="#bfc7d0" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="James Ridey" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>

  <body>
    <slot />
  </body>
</html>
